<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FBF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Screen Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌱 Crop Diary"
            android:textColor="#216B3A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Record and manage your crop information"
            android:textColor="#666666"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Crop Name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crop Name"
            android:textStyle="bold"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/etCropName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Soybean"
            android:inputType="textCapSentences"
            android:layout_marginBottom="16dp" />

        <!-- Sowing Date -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sowing Date"
            android:textStyle="bold"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/etSowingDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 15-06-2026"
            android:inputType="date"
            android:layout_marginBottom="16dp" />

        <!-- Area -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Field Area"
            android:textStyle="bold"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/etArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 2 Acres"
            android:inputType="text"
            android:layout_marginBottom="16dp" />

        <!-- Status -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crop Status"
            android:textStyle="bold"
            android:textColor="#333333" />

        <Spinner
            android:id="@+id/spinnerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Notes -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notes"
            android:textStyle="bold"
            android:textColor="#333333" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Enter additional crop information..."
            android:gravity="top"
            android:inputType="textMultiLine"
            android:layout_marginBottom="20dp" />

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveCrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SAVE CROP"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="#2E8B57"
            android:layout_marginBottom="12dp" />

        <!-- View Records Button -->
        <Button
            android:id="@+id/btnViewCrops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VIEW SAVED CROPS"
            android:textStyle="bold"
            android:textColor="#216B3A"
            android:backgroundTint="#DDEFE2" />

    </LinearLayout>

</ScrollView>