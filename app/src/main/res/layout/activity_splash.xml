<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F7FBF5"
    android:padding="32dp">

    <TextView
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:gravity="center"
        android:text="🌱"
        android:textSize="58sp"
        android:background="@drawable/bg_logo_circle"
        android:elevation="5dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Agriculture Assistant"
        android:textColor="#245C35"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Smart support for every farmer"
        android:textColor="#6D7C70"
        android:textSize="15sp" />

    <ProgressBar
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="40dp"
        android:indeterminateTint="#2E7D46" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Preparing your farming assistant..."
        android:textColor="#78847B"
        android:textSize="13sp" />

</LinearLayout>